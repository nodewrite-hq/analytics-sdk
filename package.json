{
  "name": "@nodewrite-labs/analytics-sdk",
  "version": "0.1.0",
  "description": "Analytics SDK for page views and named clicks, with Postgres storage and a Payload admin screen.",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "playground"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./payload": {
      "types": "./dist/payload/index.d.ts",
      "import": "./dist/payload/index.js"
    },
    "./payload/admin-view": {
      "types": "./dist/payload/admin-view.d.ts",
      "import": "./dist/payload/admin-view.js"
    },
    "./payload/nav-link": {
      "types": "./dist/payload/nav-link.d.ts",
      "import": "./dist/payload/nav-link.js"
    }
  },
  "files": [
    "dist",
    "src/postgres/schema.sql",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup"
  },
  "peerDependencies": {
    "@payloadcms/next": "*",
    "payload": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "@payloadcms/next": {
      "optional": true
    },
    "payload": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@payloadcms/next": "3.92.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "esbuild": "^0.28.2",
    "graphql": "^16.14.2",
    "jsdom": "^30.1.3",
    "payload": "3.92.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
